OPENROUTER_API_KEY=your-openrouter-key-here

# Optional. Unset -> /buddy/chat has no auth gate (local dev default).
# Set both here and in the Flutter build (--dart-define=APP_TOKEN=...) to
# require a matching X-App-Token header before any public deployment.
APP_TOKEN=

# Optional, comma-separated. Unset -> CORS allows any http(s)://localhost
# or 127.0.0.1 origin (any port). Set to the real origin(s) before any
# public deployment, e.g. ALLOWED_ORIGINS=https://study-buddy.example.com
ALLOWED_ORIGINS=

# Optional. Unset/0 -> APP_TOKEN may be blank (local dev default). Set to 1
# to make startup fail loudly if APP_TOKEN is unset/blank - set in
# render.yaml for the Render deployment (ST-37), leave unset locally.
# REQUIRE_APP_TOKEN=
